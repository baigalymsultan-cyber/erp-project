# =====================================================================
# ENVIRONMENT TEMPLATE (MASTER PROMPT §10, §11)
#
# Copy to .env and fill in real values. NEVER commit .env (§10).
# Supported environments: development | testing | staging | production (§11)
# =====================================================================

APP_ENV=development
APP_NAME=erp-kaspi
LOG_LEVEL=INFO
TZ_DISPLAY=Asia/Almaty

# ---------------------------------------------------------------------
# DATABASE (§13, ADR-005 — PostgreSQL is never exposed to the Internet)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://erp_app:CHANGE_ME@127.0.0.1:5432/erp_dev
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=erp_dev
DATABASE_USER=erp_app
DATABASE_PASSWORD=CHANGE_ME

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------
# SECURITY (§19, §55, ADR-009)
# ---------------------------------------------------------------------
# AES-256-GCM key: exactly 32 bytes, base64-encoded.
# Generate: openssl rand -base64 32
# NEVER store this value in the database (§19).
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
ENCRYPTION_KEY_VERSION=1

# Previous key, only during rotation (§19, ADR-009, DEF-008).
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_VERSION=

# ---------------------------------------------------------------------
# KASPI API (§18, §42)
# Endpoints are intentionally absent: the official specification has not
# been provided (OQ-003) and §94 forbids inventing API details.
# ---------------------------------------------------------------------
KASPI_SHOP_TOKEN=
KASPI_PAY_TOKEN=
KASPI_HTTP_TIMEOUT_SECONDS=30
KASPI_MAX_RETRIES=5
KASPI_RETRY_BACKOFF_SECONDS=2
KASPI_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------
# AUTH (§52–§55)
# ---------------------------------------------------------------------
# JWT signing secret: at least 32 random characters (openssl rand -base64 48)
APP_JWT_SECRET=CHANGE_ME_32+_CHARS
TRUST_PROXY=false
